
{
  "entities": {
    "LocationCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LocationCategory",
      "type": "object",
      "description": "Represents a category for listings, distinguishing between free and paid types and defining associated metadata like icon color and annual fees.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["free", "paid"] },
        "iconColorHex": { "type": "string" },
        "annualFeeEuro": { "type": "number" }
      },
      "required": ["id", "name", "description", "type", "iconColorHex"]
    },
    "Listing": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Listing",
      "type": "object",
      "description": "Represents a business or location listing. Includes denormalized ownerId and locationCategoryType for high-performance security rules.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "logoUrl": { "type": "string", "format": "uri" },
        "webAddress": { "type": "string", "format": "uri" },
        "isWebAddressIndexed": { "type": "boolean" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "photoUrls": { "type": "array", "items": { "type": "string" } },
        "videoEmbedUrls": { "type": "array", "items": { "type": "string" } },
        "locationCategoryId": { "type": "string" },
        "ownerId": { "type": "string", "description": "UID of the user who owns this listing." },
        "locationCategoryType": { "type": "string", "enum": ["Free", "Paid"] },
        "status": { "type": "string", "enum": ["draft", "pending", "active", "rejected"] },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "not_applicable"] },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "address", "city", "ownerId", "status", "locationCategoryType"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "listingName": { "type": "string" },
        "ownerId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "admin_role": {
      "title": "admin_role",
      "type": "object",
      "description": "DBAC record for administrator access."
    }
  },
  "auth": {
    "providers": ["password", "google.com", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/location_categories/{locationCategoryId}",
        "definition": {
          "entityName": "LocationCategory",
          "schema": { "$ref": "#/backend/entities/LocationCategory" },
          "description": "Global static categories. Public read."
        }
      },
      {
        "path": "/listings/{listingId}",
        "definition": {
          "entityName": "Listing",
          "schema": { "$ref": "#/backend/entities/Listing" },
          "description": "Listings with ownership rules. Public reads active only."
        }
      },
      {
        "path": "/inquiries/{inquiryId}",
        "definition": {
          "entityName": "Inquiry",
          "schema": { "$ref": "#/backend/entities/Inquiry" },
          "description": "Messages from visitors to owners."
        }
      },
      {
        "path": "/roles_admin/{adminUid}",
        "definition": {
          "entityName": "admin_role",
          "schema": { "$ref": "#/backend/entities/admin_role" },
          "description": "DBAC for superadmins."
        }
      }
    ]
  }
}
