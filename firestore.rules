
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // RULES
    match /location_categories/{locationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /listings/{listingId} {
      // Javno vidljivi samo aktivni oglasi.
      allow get: if resource.data.status == 'active' 
                 || isAdmin() 
                 || isOwner(resource.data.ownerId);
      
      // Za listanje: 
      // 1. Dozvoli svima (uključujući anonimne) ako upit eksplicitno filtrira po status == 'active'.
      // 2. Dozvoli adminu sve.
      // 3. Dozvoli vlasniku njegove oglase.
      allow list: if (resource.data.status == 'active')
                  || isAdmin()
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isOwner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow get, list: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /roles_admin/{adminUid} {
      allow get: if isAdmin() || isOwner(adminUid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
