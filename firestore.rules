
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // RULES
    match /location_categories/{locationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /listings/{listingId} {
      // Javno vidljivi samo aktivni oglasi.
      // Vlasnici i admini vide sve (nacrte, odbijene).
      
      allow get: if resource.data.status == 'active' 
                 || isAdmin() 
                 || isOwner(resource.data.ownerId);
      
      // Za listanje: 
      // 1. Ako korisnik filtrira po status == 'active', dozvoli svima.
      // 2. Ako je admin, dozvoli sve.
      // 3. Ako je vlasnik i filtrira po svom ownerId, dozvoli.
      allow list: if (resource.data.status == 'active')
                  || isAdmin()
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      
      // Kreiranje: Korisnik mora postaviti sebe kao vlasnika.
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      
      // Ažuriranje: Samo vlasnik ili admin. Vlasnik ne smije mijenjati ownerId.
      allow update: if isAdmin() || (isOwner(resource.data.ownerId) && request.resource.data.ownerId == resource.data.ownerId);
      
      allow delete: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /inquiries/{inquiryId} {
      // Svatko može poslati upit, samo vlasnik oglasa ili admin može čitati.
      allow create: if true;
      allow get, list: if isAdmin() || isOwner(resource.data.ownerId);
    }

    match /roles_admin/{adminUid} {
      // DBAC: Samo postojeći admin može dodijeliti novog admina. 
      // Korisnik može vidjeti svoj vlastiti admin status.
      allow get: if isAdmin() || isOwner(adminUid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
