rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner() {
      return resource != null && isOwner(resource.data.ownerId);
    }

    match /location_categories/{locationCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /amenities/{amenityId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /article_categories/{articleCategoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tags/{tagId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /advertisements/{advertisementId} {
      allow get, list: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow get: if isAdmin() || resource.data.status == 'active' || isOwner(resource.data.ownerId);
      allow list: if isAdmin() || resource.data.status == 'active' || (isSignedIn() && request.auth.uid == resource.data.ownerId); 
      
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isExistingOwner() && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin() || isExistingOwner();
    }

    match /subscriptions/{subscriptionId} {
      allow get: if isAdmin() || isOwner(resource.data.listingOwnerId);
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.listingOwnerId); 
      allow create, update, delete: if isAdmin();
    }

    match /articles/{articleId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /roles_admin/{adminUid} {
      allow get: if isAdmin() || isOwner(adminUid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
